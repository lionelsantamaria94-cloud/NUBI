	# Copia este archivo como .env (en tu PC) o crea estas variables en el panel de tu hosting.
# Nunca subas el archivo .env a ningún sitio público: ahí está tu clave.

# Obligatoria para el chat, las sugerencias y las fotos. Se saca de Google AI Studio.
GEMINI_API_KEY=AQ.Ab8RN6JmZ6--QlU9Z6CKdXMENsLRxejptuwo2Dse67vJi2gkSA

# Modelo de Gemini. Debe aceptar imágenes y respuestas en JSON.
MODEL=gemini-3.8-flash

# Dirección pública de tu app, sin barra final. Sirve para Google y para compartir.
# SITE_URL=https://nubi.onrender.com

# Correo de contacto que aparece en privacidad y términos (obligatorio para Play Store).
# CONTACT_EMAIL=tu-correo@ejemplo.com

# Código de verificación de Google Search Console (solo el valor de content="...")
# GOOGLE_SITE_VERIFICATION=

# Pon 1 si tu hosting está detrás de un proxy (Render, Railway, Fly). Activa HSTS.
# TRUST_PROXY=1

# Límites de consultas de IA por visitante. Protegen tu cuota de Gemini.
# RATE_PER_MIN=15
# RATE_PER_DAY=120

# Tiempos de espera de la IA, en milisegundos.
# AI_ATTEMPT_MS=45000
# AI_DEADLINE_MS=70000
# THINKING_LEVEL=low

# Puerto local. En Render o Railway se asigna solo.
# PORT=3000
